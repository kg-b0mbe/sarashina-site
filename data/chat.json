      "news": {
        "title": "漢字の「読み分け」に挑む、日本語のための音声合成",
        "title_ja": "漢字の「読み分け」に挑む、日本語のための音声合成",
        "paper_id": "sarashina2.2-tts",
        "lang": "ja",
        "kind": "paper",
        "link": "https://arxiv.org/abs/2606.25369"
      },
      "lines": [
        {
          "who": "さら",
          "text": "はい、論文コーナー！今回は日本語音声合成だって。"
        },
        {
          "who": "しな",
          "text": "音声合成、英語や中国語が中心なのよね。日本語は課題ありみたい。"
        },
        {
          "who": "さら",
          "text": "日本語、何が難しいの？"
        },
        {
          "who": "しな",
          "text": "同じ漢字でも読み方が違うの。そこが課題みたい。"
        },
        {
          "who": "さら",
          "text": "あっ、「生」！これ読めない…「せい」？「なま」？"
        },
        {
          "who": "しな",
          "text": "そう。周りの言葉で変わっちゃうの。「生野菜」は「なま」、「先生」は「せい」"
        },
        {
          "who": "さら",
          "text": "そういえばスマホの読み上げ、たまに変な読み方するよね"
        },
        {
          "who": "しな",
          "text": "それがこの研究の狙いどころ。アプローチは二本立てよ"
        },
        {
          "who": "しな",
          "text": "音声データ大量収集と、読み間違えやすい箇所の合成学習、二本立てよ"
        },
        {
          "who": "さら",
          "text": "狙い撃ち合成って、どんなの？"
        },
        {
          "who": "しな",
          "text": "苦手な読みを重点練習。苦手は漢字の読み分けね"
        },
        {
          "who": "しな",
          "text": "評価用ベンチマークは常用漢字の読み確認。短い音声から声を再現する機能もあるよ"
        },
        {
          "who": "さら",
          "text": "へー、スマホの話から漢字の読み練習につながったね！"
        },
        {
          "who": "しな",
          "text": "次はどんな音声技術の話か楽しみね。"
        }
      ],
      "model": "sarashina2.2-3b",
      "made": {
        "draft": "GLM-5.3-Flash",
        "voice": "sarashina2.2-3b"
      }
