<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac mini で Sarashina2.2-3B（llama.cpp の llama-server）を常駐させる（launchd）。
  2026-11-24、Sparkの2台目に同居させていたらGLMのmemguard（空き2.5GiBの下限）に触れたので、Mac miniへ引っ越した。
  外からは使わせないので 127.0.0.1 だけで待ち受ける。HOME_PATH は登録するときに sed で置き換える。
  止まったら launchd が起動し直す（KeepAlive）。記録は /tmp/sarashina-llama.log。
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>jp.sarashina-site.llama</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/llama-server</string>
    <string>--model</string><string>HOME_PATH/models/sarashina/sarashina2.2-3b-instruct-v0.1-Q8_0.gguf</string>
    <string>--alias</string><string>sarashina2.2-3b</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8010</string>
    <string>--api-key-file</string><string>HOME_PATH/.sarashina_api_key</string>
    <string>--ctx-size</string><string>8192</string>
    <string>--parallel</string><string>1</string>
    <string>--n-gpu-layers</string><string>99</string>
    <string>--jinja</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/sarashina-llama.log</string>
  <key>StandardErrorPath</key><string>/tmp/sarashina-llama.log</string>
</dict>
</plist>
