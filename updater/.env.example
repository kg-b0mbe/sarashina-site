# Mac miniの updater/.env にコピーして値を埋める（.env はGitに入らない）
# cp updater/.env.example updater/.env

# DGX SparkのSarashina（2台目 spark-c00e の llama.cpp。TailscaleのACLで tag:agent → tag:server の tcp:8010 を許可しておく）
SARASHINA_BASE_URL=http://spark-c00e:8010/v1
SARASHINA_API_KEY=ここにSparkの ~/.sarashina_api_key の中身
SARASHINA_MODEL=sarashina2.2-3b

# Slackの Incoming Webhook URL（個人事業用ワークスペースの通知チャンネル）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 公開ブランチ
GIT_BASE_BRANCH=main

# 1回の実行で提案する最大件数
MAX_ITEMS_PER_RUN=6

# 海外（OpenAI・Anthropic・Google）の動きも探すか（1=探す / 0=探さない）
WATCH_WORLD=1

# 提案済みの記録を置く場所（リポジトリの外）
STATE_DIR=~/.sarashina-site

# さらとしなの茶話（1=動かす / 0=止める）
CHAT_ENABLED=1
