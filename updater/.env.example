# Mac miniの updater/.env にコピーして値を埋める（.env はGitに入らない）
# cp updater/.env.example updater/.env

# DGX SparkのSarashina（2台目 spark-c00e の llama.cpp。TailscaleのACLで tag:agent → tag:server の tcp:8010 を許可しておく）
SARASHINA_BASE_URL=http://spark-c00e:8010/v1
SARASHINA_API_KEY=ここにSparkの ~/.sarashina_api_key の中身
SARASHINA_MODEL=sarashina2.2-3b

# Slackの Incoming Webhook URL（個人事業用ワークスペースの通知チャンネル）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 公開ブランチ
GIT_BASE_BRANCH=main

# 1回の実行で提案する最大件数
MAX_ITEMS_PER_RUN=6

# 海外（OpenAI・Anthropic・Google）の動きも探すか（1=探す / 0=探さない）
WATCH_WORLD=1

# 提案済みの記録を置く場所（リポジトリの外）
STATE_DIR=~/.sarashina-site

# さらとしなの茶話（1=動かす / 0=止める）
CHAT_ENABLED=1

# 茶話の聞き比べ（updater/chat_compare.py）で、あらすじを作るGLM
# Hermesなどがつないでいるのと同じ、SparkのGLMのAPI。GLM_MODELは空なら自動で選ぶ
GLM_BASE_URL=http://spark-a436:8888/v1
GLM_API_KEY=ここにGLMのAPIキー
GLM_MODEL=

# 茶話のセリフを書く Sarashina3.2 mini thinking（sarashina.ai のAPI）。聞き比べ（chat_compare.py）でも使う
# 書かなければ使わない。止めたいときは SARASHINA_CLOUD_ENABLED=0 を足す（手元のSarashinaの言い直しに戻る）。手元のSarashina用の SARASHINA_API_KEY とは別のキー
SARASHINA_CLOUD_API_KEY=
SARASHINA_CLOUD_MODEL=sarashina3.2-mini-thinking
SARASHINA_CLOUD_BASE_URL=https://api.sarashina.ai/v1
SARASHINA_CLOUD_EXTRA={"reasoning_effort":"low"}
